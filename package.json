{
  "name": "jtcrpa-mcp",
  "version": "0.7.0",
  "type": "module",
  "description": "在 macOS 和 Windows 上用 Codex 等 AI 客户端连接九头虫 Agent，创建和运行网页采集工作流、读取数据集。Connect AI clients to Jiutouchong Agent on macOS and Windows via MCP to create and run web scraping workflows and read datasets.",
  "homepage": "https://jtcrpa.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhulinjia/jtcrpa-mcp-bridge.git"
  },
  "publishConfig": { "registry": "https://registry.npmjs.org", "access": "public" },
  "engines": { "node": ">=20.19.0" },
  "os": ["win32", "darwin"],
  "bin": { "jtcrpa-mcp": "bin/cli.mjs" },
  "files": ["bin", "dist", "windows", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": { "@modelcontextprotocol/server": "2.4.0", "zod": "4.4.3" },
  "devDependencies": { "@modelcontextprotocol/client": "2.4.0", "@types/node": "^24.0.0", "typescript": "~5.9.3" }
}
